class RealScale:
    @property
    def min(self) -> float: ...

    @property
    def max(self) -> float: ...

    @property
    def size(self) -> int: ...

    @property
    def length(self) -> float: ...

    def index(self, arg: float, /) -> int: ...

    def bounds(self, arg: int, /) -> tuple[float, float]: ...

    def __repr__(self) -> str: ...

class LinearRealScale(RealScale):
    def __init__(self, arg0: float, arg1: float, arg2: int, /) -> None: ...

    def step(self) -> float: ...

class Log2RealScale(RealScale):
    def __init__(self, arg0: float, arg1: float, arg2: int, /) -> None: ...

class Log10RealScale(RealScale):
    def __init__(self, arg0: float, arg1: float, arg2: int, /) -> None: ...

class IntegerScale:
    @property
    def min(self) -> int: ...

    @property
    def max(self) -> int: ...

    @property
    def size(self) -> int: ...

    @property
    def length(self) -> int: ...

    def index(self, arg: float, /) -> int: ...

    def bounds(self, arg: int, /) -> tuple[float, float]: ...

    def __repr__(self) -> str: ...

class LinearIntegerScale(IntegerScale):
    def __init__(self, arg0: int, arg1: int, arg2: int, /) -> None: ...

    def step(self) -> int: ...

class Log2IntegerScale(IntegerScale):
    def __init__(self, arg0: int, arg1: int, arg2: int, /) -> None: ...

class Log10IntegerScale(IntegerScale):
    def __init__(self, arg0: int, arg1: int, arg2: int, /) -> None: ...
